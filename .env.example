# Cuentas opcionales con Firebase. Copia este archivo a .env.local para probarlas en tu equipo.
# Sin estos valores, la app funciona solo en el navegador y no muestra la opción de cuenta.
# Son públicos por diseño: los datos los protegen las reglas de firestore.rules.
# Se obtienen en Firebase: Configuración del proyecto > General > Tus apps > App web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
